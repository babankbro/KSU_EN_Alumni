# Copy to .env for docker compose, or to .env.local for `npm run dev`.
# These values are for LOCAL DEVELOPMENT ONLY.

# ---- PostgreSQL ----
POSTGRES_DB=alumni
POSTGRES_USER=alumni
POSTGRES_PASSWORD=alumni_dev_only
POSTGRES_PORT=5432

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
MINIO_BUCKET=alumni-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Web ----
WEB_PORT=3000
# Bump when the privacy notice changes; stored on every consent record.
POLICY_VERSION=2569-10-30

# ---- Used only by `npm run dev` outside Docker (.env.local) ----
# DATABASE_URL=postgres://alumni:alumni_dev_only@localhost:5432/alumni
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin_dev_only

# ---- Admin bootstrap ----
# On first start, if no admin account exists, one is created from these.
# Use a password of at least 12 characters; it is ignored once any admin exists.
ADMIN_BOOTSTRAP_EMAIL=admin@alumni.local
ADMIN_BOOTSTRAP_PASSWORD=
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Trust X-Forwarded-For (only behind a reverse proxy that sets it).
# Inside plain Docker every request comes from the bridge gateway, so leave false.
TRUST_PROXY=false

# ---- App ----
# Long random string. Signs unsubscribe and one-click links.
APP_SECRET=
APP_URL=http://localhost:3000
# Shared secret for the cron service that calls /api/internal/cron
CRON_SECRET=

# ---- Email ----
# The compose file includes Mailpit for development: SMTP_HOST=mailpit, UI on :8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ศิษย์เก่าวิศวกรรมศาสตร์ ม.กาฬสินธุ์ <no-reply@example.ac.th>"
MAILPIT_UI_PORT=8025

# ---- LINE (optional — leave empty to disable) ----
# LINE Login channel (FR-AUTH-03): callback URL is ${APP_URL}/api/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API channel access token (FR-NOTI-01)
LINE_MESSAGING_ACCESS_TOKEN=

# Attach bundled sample photos to the fictional seed records (development only)
DEMO_SEED_MEDIA=false

# NFR-SEC-05 backups (./backups — keep it off Git, copy it off this machine)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
